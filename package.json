{
  "name": "hedera-contract-workbench",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/mcp",
    "packages/nextjs",
    "packages/hardhat"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:runtime": "npm run build -w @sh/core && npm run build -w @sh/cli && npm run build -w @sh/mcp",
    "build": "node scripts/build.mjs",
    "lint": "eslint packages scripts --max-warnings 0",
    "typecheck": "npm run build:runtime && npm run typecheck -w @sh/nextjs && npm run typecheck -w @sh/hardhat",
    "test": "npm run build:runtime && npm run test -w @sh/core && npm run test -w @sh/hardhat",
    "format": "prettier --write .",
    "workbench": "node scripts/workbench.mjs",
    "mcp": "node packages/mcp/dist/index.js",
    "verify:adapters": "npm run build:runtime && node scripts/verify-adapters.mjs",
    "verify:local": "npm run build:runtime && npm run compile -w @sh/hardhat && node scripts/verify-local.mjs",
    "verify:receipts": "npm run build:runtime && tsx --tsconfig packages/nextjs/tsconfig.json scripts/verify-receipt-adapters.mts",
    "verify:assistant": "npm run build:runtime && tsx scripts/verify-assistant.mts",
    "verify:generic": "npm run build:runtime && tsx --tsconfig packages/nextjs/tsconfig.json scripts/verify-generic.mts",
    "verify:skills": "npm run build:runtime && node scripts/verify-skills.mjs",
    "verify:generic-network": "npm run build:runtime && tsx scripts/verify-generic-network.mts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "24.5.2",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "overrides": {
    "use-sync-external-store": "1.6.0",
    "abitype": "1.3.0"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "16.3.8",
    "@next/swc-darwin-x64": "16.3.8",
    "@next/swc-linux-arm64-gnu": "16.3.8",
    "@next/swc-linux-arm64-musl": "16.3.8",
    "@next/swc-linux-x64-gnu": "16.3.8",
    "@next/swc-linux-x64-musl": "16.3.8",
    "@next/swc-win32-arm64-msvc": "16.3.8",
    "@next/swc-win32-x64-msvc": "16.3.8"
  }
}
