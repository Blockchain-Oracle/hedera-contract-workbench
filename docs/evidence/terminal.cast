[1.246794749982655, "o", "\u001b[1m\r\nContract Workbench\u001b[22m\r\n"]
[1.2468424580001738, "o", "\u001b[32m\u2713\u001b[39m runtime: Node 24.19.0; Node 24 LTS recommended\r\n\u001b[32m\u2713\u001b[39m network: Hedera testnet (296)\r\n\u001b[32m\u2713\u001b[39m registry: Local imports and bundled examples are readable\r\n"]
