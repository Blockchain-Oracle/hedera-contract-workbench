[1.4221927500038873, "o", "\u001b[1mSaucerSwap V1 router\u001b[22m  \u001b[2mtestnet\u001b[22m\r\n"]
[1.4222907919902354, "o", "  \u001b[36msaucerswap-testnet\u001b[39m \u00b7 0x0000000000000000000000000000000000004b40\r\n\u001b[1mSAUCE token\u001b[22m  \u001b[2mtestnet\u001b[22m\r\n  \u001b[36msauce-testnet\u001b[39m \u00b7 0x0000000000000000000000000000000000120f46\r\n\u001b[1mSaucerSwap V1 router\u001b[22m  \u001b[2mmainnet\u001b[22m\r\n  \u001b[36msaucerswap-mainnet\u001b[39m \u00b7 0x00000000000000000000000000000000002E7A5D\r\n\u001b[1mSAUCE token\u001b[22m  \u001b[2mmainnet\u001b[22m\r\n  \u001b[36msauce-mainnet\u001b[39m \u00b7 0x00000000000000000000000000000000000b2aD5\r\n\u001b[1mSaucerSwap factory\u001b[22m  \u001b[2mtestnet\u001b[22m\r\n"]
