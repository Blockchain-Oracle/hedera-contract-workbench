# Optional chat. An explicit model ID is required.
WORKBENCH_AI_PROVIDER=openai
WORKBENCH_AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# WORKBENCH_AI_PROVIDER also accepts anthropic or gemini with a compatible model.
# Optional public / provider RPC overrides. Never expose provider keys in client variables.
# WORKBENCH_RPC_TESTNET_URL=https://testnet.hashio.io/api
# WORKBENCH_RPC_MAINNET_URL=https://mainnet.hashio.io/api
# WORKBENCH_NETWORK=testnet
# WORKBENCH_RPC_CONCURRENCY=4
# WORKBENCH_WEB_URL=http://127.0.0.1:3000
