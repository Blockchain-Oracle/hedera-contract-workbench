{
  "name": "@sh/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "viem": "2.57.2",
    "abitype": "1.3.0",
    "zod": "4.6.5",
    "dotenv": "16.6.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "tsx --test test/*.test.ts"
  },
  "exports": {
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./inputs": {
      "types": "./dist/inputs.d.ts",
      "default": "./dist/inputs.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
